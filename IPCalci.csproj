<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>true</IsPackable>

    <!-- NuGet Package Metadata -->
    <PackageId>IPCalci</PackageId>
    <Version>1.0.0</Version>
    <Authors>Kasali</Authors>
    <Company>Kasali</Company>
    <Description>High-performance .NET library for calculating and parsing IPv4 and IPv6 subnets, network addresses, usable host ranges, and CIDR notations.</Description>
    <PackageTags>ipv4;ipv6;ip;subnet;calculator;cidr;networking;network</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
